(version 1)
; M27 offline profile for macOS sandbox-exec. Parameters: REAL_HOME (the real home directory) and
; RUN_TMP (the run's TMPDIR, a realpath outside REAL_HOME).
; Outbound network only to loopback; no lookup of network-capable daemons; no reads under the real
; home directory (OD-14). F-0 profile of 2026-11-14 plus the scoped Unix-socket allow below.
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*") (remote ip4 "localhost:*"))
; Provider plugins talk to the engine over Unix sockets in TMPDIR (go-plugin); only that subtree.
(allow network-outbound (remote unix-socket (subpath (param "RUN_TMP"))))
(deny mach-lookup
  (global-name "com.apple.mDNSResponder")
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.nsurlsessiond")
  (global-name "com.apple.nsurlsessiond.NSURLSessionProxyService")
  (global-name "com.apple.nehelper")
  (global-name "com.apple.networkd")
  (global-name "com.apple.symptomsd")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent"))
(deny file-read* (subpath (param "REAL_HOME")))
